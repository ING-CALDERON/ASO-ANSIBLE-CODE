[global]
    workgroup = WORKGROUP
    server string = Samba Server OpenSUSE
    security = user
    map to guest = bad user

[RecursoCompartido]
    path = /opt/recurso_samba
    valid users = smbuser
    browsable = yes
    writable = yes
    guest ok = no
    create mask = 0664
    directory mask = 0775
